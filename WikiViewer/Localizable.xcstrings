    "“%@” does not exist in the vault snapshot. Obsidian would create it when the link is clicked; this viewer is read-only.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "「%@」は Vault のスナップショットにありません。Obsidian ではリンクをタップすると作成されますが、このビューアは読み取り専用です。"
          }
        }
      }
    },
