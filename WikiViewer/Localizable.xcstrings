        }
      }
    },
    "Terms under 3 characters only match titles, aliases and tags. Add a longer term to search note text.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "2文字以下の語はタイトル・別名・タグのみ検索します。本文を検索するには3文字以上の語を加えてください。"
          }
        }
      }
    },
    "The vault's name as shown in Obsidian. Used by Edit in Obsidian and shared links.": {
      "localizations": {
        "ja": {
          "stringUnit": {
            "state": "translated",
            "value": "Obsidian に表示される Vault の名前。「Obsidian で編集」と共有リンクに使います。"
